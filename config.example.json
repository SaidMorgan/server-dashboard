// Comments are allowed in this file — // and /* */ both work.
// ${VAR} is read from the environment or from .env, so no password is ever
// written here. Every value below is optional; these are the defaults.
{
  "port": 8770,

  // Loopback only by default. Binding to 0.0.0.0 exposes the dashboard to your
  // network and requires auth.password to be set — the app refuses otherwise.
  "bind": "127.0.0.1",

  // How often every target is polled, in seconds. Below ~5 you are mostly
  // hammering your own servers.
  "pollSeconds": 10,

  // How much per-target history the graphs keep, in hours.
  "historyHours": 48,

  "auth": {
    "password": "${DASHBOARD_PASSWORD}",
    "sessionDays": 30       // how long a login lasts before you sign in again
  },

  "notifications": {
    "windowsToast": true,   // desktop balloon on errors, for a machine you sit at

    // Anti-spam. An identical message is sent at most once per dedupeSeconds,
    // and never more than maxPerMinute in total, so a server that flaps up and
    // down can't flood the channel or get your webhook rate-limited.
    "dedupeSeconds": 60,
    "maxPerMinute": 10,

    "discord": {
      "enabled": false,
      "url": "${DISCORD_WEBHOOK_URL}",

      // Which levels this channel wants.
      "events": ["error", "warn"],

      // Categories to drop regardless of level. Backups, planned restarts and
      // Steam update news are routine bookkeeping, better read in the dashboard
      // than pushed to everyone's phone — a nightly reset that goes to plan says
      // nothing you didn't already know was coming. The feed keeps them either way.
      "mute": ["backup", "restart", "update"],

      // The reverse: categories to send even when their level isn't in
      // "events". "recovery" is the all-clear after an unplanned outage — it's
      // only an info, but if the crash was worth waking up for, so is the news
      // that the server came back.
      "always": ["recovery"]
    },
    "webhook": {
      "enabled": false,
      "url": "",
      "events": ["error"]
    }
  },

  // Defaults for every target's backups. Per-target "backup" blocks win.
  "backups": {
    // Seconds given to a save command to reach disk before the copy starts.
    "flushSeconds": 4,

    // Ceilings, not expected durations. A large world is slow, and a backup
    // that takes 15 minutes beats one killed at 5.
    "stageTimeoutMinutes": 10,
    "zipTimeoutMinutes": 20
  },

  "alerts": {
    // Alerts kept in the activity feed and data/alerts.json. This is a
    // recent-activity view, not an audit log.
    "keep": 200
  },

  // A service target can also carry "readyAfterSeconds": how long it takes to
  // answer its healthUrl after being started. Alerts for it stay suppressed that
  // long after a managed restart, so a slow-starting API doesn't report the tail
  // of its own nightly restart as an outage that recovered.

  "restart": {
    // Extra seconds after a shutdown countdown ends before the process is
    // force-killed. The countdown ends when the server *starts* exiting;
    // flushing a large world to disk happens after that.
    "graceSeconds": 90
  },

  // Steam build checks, for game targets that have a "steamAppId" (most fill it
  // in from their game profile). The dashboard never downloads anything: it
  // compares the build Steam has installed against the one Steam is publishing,
  // and the "Check for update" button stops the server so YOU can install the
  // update in the Steam client. It starts the server again by itself once the
  // files change. See README.md.
  "steam": {
    // How often to check in the background. A new alert is raised once per new
    // build, not once per check.
    "checkMinutes": 360,

    // How long to keep a server stopped waiting for you to press Update in
    // Steam. When this runs out the server is started again on the build it
    // already has, rather than staying down overnight.
    "waitMinutes": 60,

    // Path to steamcmd.exe. With it set, a target marked "autoUpdate": true is
    // stopped, updated and restarted without you touching Steam -- but only
    // while it is empty. Without it, the dashboard can only stop and wait.
    "steamcmd": "C:\\Apps\\steamcmd\\steamcmd.exe",
    "updateTimeoutMinutes": 60

    // "library": "D:\\SteamLibrary\\steamapps"  // extra folder to look in
  },

  // Minecraft version checks, for "bedrock" and "minecraft" targets. Unlike the
  // Steam block above, this one installs what it finds: nothing else owns a
  // Minecraft install, so the dashboard stops the server, downloads the
  // release, puts it in place, deletes the download and starts the server
  // again, with nothing to press in between. See README.md.
  "minecraft": {
    // How often to check in the background. A new alert is raised once per new
    // version, not once per check.
    "checkMinutes": 360,

    // Ceilings, not expected durations. The Bedrock zip is around 95 MB and
    // unpacks to roughly ten thousand files.
    "downloadTimeoutMinutes": 30,
    "extractTimeoutMinutes": 15,

    // The download is deleted once it is installed. Turn this on to keep it:
    // Mojang publishes no archive of past Bedrock releases, so a kept zip is
    // the only offline way back to the version you were on.
    "keepDownloads": false
  },

  "targets": [
    {
      "id": "ark-island",
      "name": "ARK: The Island",
      "kind": "game",
      "game": "ark",
      "host": "127.0.0.1",
      "gamePort": 7777,
      "queryPort": 27015,
      "rconPort": 27020,
      "rconPassword": "${ARK_RCON_PASSWORD}",
      "maxPlayers": 10,
      "processName": "ArkAscendedServer",
      "startCommand": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\ARK Survival Ascended Dedicated Server\\ShooterGame\\Saved\\Start Island.bat",
      "logFile": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\ARK Survival Ascended Dedicated Server\\ShooterGame\\Saved\\Logs\\ShooterGame.log",

      "watchdog": {
        "enabled": true,
        "restartAfterSeconds": 60,
        "maxRestartsPerHour": 3
      },

      "backup": {
        "enabled": true,

        // Folders to archive. Everything here lands in one zip per run.
        "paths": [
          "C:\\Program Files (x86)\\Steam\\steamapps\\common\\ARK Survival Ascended Dedicated Server\\ShooterGame\\Saved\\SavedArks"
        ],

        // How many archives to keep. Retention is by COUNT, not age: nothing
        // expires for being old, and the oldest is deleted only after a
        // successful backup. Watch the disk — a big world is ~300 MB a copy.
        "keep": 10,

        // Also back up automatically just before any restart, while the save
        // files are at rest. The last chance to roll back a bad update.
        "beforeRestart": true

        // "dir": "D:\\Backups\\ark"   // optional; defaults to backups/<id>
      },

      "schedules": [
        {
          "cron": "0 5 * * *",
          "action": "restart",
          "warnMinutes": 15,
          "reason": "nightly restart"
        },
        {
          "cron": "0 */6 * * *",
          "action": "backup"
        }
      ]
    },

    {
      "id": "palworld",
      "name": "Palworld",
      "kind": "game",
      "game": "palworld",
      "host": "127.0.0.1",
      "gamePort": 8211,
      "restPort": 8212,
      "adminPassword": "${PALWORLD_ADMIN_PASSWORD}",
      "maxPlayers": 32,
      "shutdownCountdownSeconds": 60,
      "processName": "PalServer-Win64-Shipping-Cmd",
      "startCommand": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\PalServer\\Start.bat",

      // Steam Workshop mods: reported, never installed. The game itself can be
      // updated unattended because app_update is verifiable and repairable; a
      // mod is built against one game build, can take the server down on the
      // first player join, and has no validate to undo it. So a stale mod
      // raises a flag on the card and in your alert channel, and you refresh it
      // in whatever mod manager put it there.
      //
      // appId is the GAME, not the dedicated server -- workshop items belong to
      // the game, so this is 1623730 for Palworld while steamAppId is 2394010.
      // modsDir holds one subfolder per installed mod, each with the
      // InstallManifest.json naming the workshop item it came from.
      // workshopDir is optional and only needed if the Steam client lives
      // somewhere other than the default library.
      "workshopMods": {
        "appId": 1623730,
        "modsDir": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\PalServer\\Mods\\ManagedMods"
      },

      // Optional, and separate from the block above. workshopMods answers "is an
      // update waiting?", which by design says nothing while everything is
      // current. This is where the card's Mods panel looks for the standing
      // list of what is installed -- and it works for games that have no Steam
      // Workshop to compare against at all.
      //
      // Most games find this from their own profile, so you only need it when
      // your install is laid out differently. "kind" is "workshop" for one
      // folder per mod each with an InstallManifest.json, or "paks" for loose
      // Unreal .pak files. Read-only either way: nothing installs, enables or
      // removes a mod.
      //
      // "mods": {
      //   "dir": "C:\\GameServers\\IcarusServer\\Icarus\\Mods",
      //   "kind": "paks"
      // },

      "backup": {
        "enabled": true,
        "paths": ["C:\\Program Files (x86)\\Steam\\steamapps\\common\\PalServer\\Pal\\Saved\\SaveGames"],
        "keep": 20,
        "beforeRestart": true
      }
    },

    {
      "id": "minecraft",
      "name": "Minecraft",
      "kind": "game",
      "game": "minecraft",
      "host": "127.0.0.1",
      "gamePort": 25565,
      "rconPort": 25575,
      "rconPassword": "${MINECRAFT_RCON_PASSWORD}",
      "maxPlayers": 20,
      "processName": "java",
      "startCommand": "C:\\Servers\\Minecraft\\start.bat",
      "logFile": "C:\\Servers\\Minecraft\\logs\\latest.log",

      // Optional -- the whole block. A Java target already says where it starts
      // from, and both the install folder and the version on disk are worked
      // out from that, so "Check for update" works with none of this set. What
      // is here is for installs laid out unusually, and for the real choices:
      //
      //   flavor  "vanilla" takes Mojang's server jar, "paper" takes PaperMC
      //           builds. The Minecraft version is read from the jar itself.
      //   track   which new versions count. "same" holds the Minecraft version
      //           you are on and takes newer builds of it; "latest" follows
      //           Minecraft releases; or name a version to pin to. Defaults to
      //           "same" for Paper and "latest" for vanilla, because every
      //           plugin on a Paper server is built against one Minecraft
      //           version, and carrying them across a version bump unattended
      //           is how a server comes back up with half of them refusing to
      //           load.
      //   auto    install it as soon as one appears AND the server is empty.
      //           Off by default: a version bump can break plugins, and a
      //           notice plus a button is the safer trade for most people.
      //
      // "jar" names the file to replace if it is not server.jar, and
      // "installDir" the folder if it is not the one start.bat sits in. The
      // jar being replaced is kept, so there is always a way back.
      "minecraftUpdate": {
        "flavor": "vanilla",
        "track": "latest",
        "auto": false
        // "jar": "paper.jar",
        // "installDir": "C:\\Servers\\Minecraft"
      },

      // The other half of a Paper install: the jars in plugins/. Off unless
      // this block is present, and it does nothing on a vanilla server, which
      // has no plugins folder.
      //
      // Each plugin is matched to its publisher by the name in its own
      // plugin.yml. Common ones (Geyser, Floodgate, GriefPrevention, Prism,
      // VeinMiner, NBTAPI...) are in the catalogue in src/pluginupdate.js and
      // need nothing here. Sources are NEVER guessed by searching for a name --
      // Modrinth has a "veinminer" that is not the VeinMiner most servers run,
      // and installing that over yours would be worse than never updating.
      //
      // Every jar is verified against the publisher's own checksum before
      // anything is stopped, and one restart installs all of them. The jar each
      // one replaces is kept under the dashboard's data folder.
      //
      //   auto                 install when an update appears AND the server is
      //                        empty. Off by default, like the jar updater.
      //   requireGameVersion   refuse a release that does not list the running
      //                        Minecraft version. Off by default: plugins are
      //                        often slow to add a new version to their list,
      //                        so this refuses far more than it protects. It is
      //                        reported on the plugin either way.
      //   sources              add or override an entry. "Name": false never
      //                        updates that plugin.
      "pluginUpdates": {
        "auto": false
        // "requireGameVersion": true,
        // "sources": {
        //   "MyPlugin":    { "provider": "modrinth", "project": "my-plugin" },
        //   "OtherPlugin": { "provider": "hangar", "project": "OtherPlugin" },
        //   "ThirdPlugin": { "provider": "github", "repo": "owner/repo",
        //                    "asset": "^ThirdPlugin-[0-9.]+[.]jar$" },
        //   "Geyser-Spigot": false
        // }
      }
    },

    {
      "id": "bedrock",
      "name": "Minecraft (Bedrock)",
      "kind": "game",
      "game": "bedrock",
      "host": "127.0.0.1",

      // Both 19132, and not a typo: Bedrock answers the ping on the same port
      // players connect to. It is UDP -- a firewall rule copied from a Java
      // server will not pass it.
      "gamePort": 19132,
      "queryPort": 19132,
      "maxPlayers": 10,

      // The Source RCON listener tools/bds-supervisor.js puts in front of the
      // BDS console -- BDS has no RCON of its own. Loopback only, and it must
      // stay that way: the password crosses this socket in plaintext.
      "rconPort": 25585,
      "rconPassword": "${BEDROCK_RCON_PASSWORD}",
      "processName": "bedrock_server",
      "startCommand": "C:\\GameServers\\Bedrock\\Minecraft Start.bat",
      "logFile": "C:\\GameServers\\Bedrock\\logs\\latest.log",

      // Optional, like the Java one above and for the same reason: the folder
      // and the installed version are both worked out from what is already
      // here. Pressing "Check for update" downloads the current Bedrock zip,
      // unpacks it over this folder, deletes the zip and starts the server.
      //
      // Four names are never overwritten -- server.properties, allowlist.json,
      // whitelist.json and permissions.json, all of which the zip ships stock
      // copies of -- and neither are worlds\\ or the development_* folders.
      // Nothing is ever deleted either, so your own packs and scripts survive.
      // "keep" adds to that list; end an entry with "/" for a whole folder.
      //
      // "auto" is a safer proposition here than on a modded Java server:
      // Bedrock has no plugins to break, so an empty server updating itself
      // overnight is mostly upside.
      "minecraftUpdate": {
        "auto": true,
        "keep": ["my-scripts/"]
        // "preview": true   // follow the preview channel instead
      },

      "backup": {
        "enabled": true,
        "paths": ["C:\\GameServers\\Bedrock\\worlds"],
        "keep": 20,
        "beforeRestart": true
      }
    },

    {
      "id": "example-service",
      "name": "Example Windows Service",
      "kind": "service",
      "serviceName": "MyApiService",
      "healthUrl": "http://127.0.0.1:3001/health",
      "nssm": "C:\\Apps\\nssm\\nssm.exe",
      "logDir": "C:\\Apps\\MyApi\\logs",

      // Optional. Adds an "Update & restart" button beside "Restart now":
      // the service is stopped, these run in order, then it starts again.
      // Omit it and only the plain restart is offered.
      "preRestartCommand": [
        "git pull --ff-only",
        "npm ci --omit=dev"
      ],
      "preRestartDir": "C:\\Apps\\MyApi",
      "preRestartTimeoutMinutes": 5
    }
  ]
}
