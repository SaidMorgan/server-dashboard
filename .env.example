# Copy to .env and fill in. .env is gitignored; config.json refers to these by
# name with ${VAR}, so your config.json stays safe to share.
#
# Anything here can equally be set as a real environment variable instead —
# useful when running as a Windows service.

# Required only if you bind the dashboard to anything other than localhost.
# Leave blank for a localhost-only install; the dashboard will not ask you to
# log in.
DASHBOARD_PASSWORD=

# Game server credentials.
ARK_RCON_PASSWORD=
PALWORLD_ADMIN_PASSWORD=
MINECRAFT_RCON_PASSWORD=

# Optional: alerts. Discord > Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Optional: a Steam Web API key, from https://steamcommunity.com/dev/apikey
# (free, one per Steam account). One thing uses it — checking whether a Steam
# game server is actually being advertised in the server browser, which nothing
# local can answer: a server can answer its own query port for hours while being
# listed nowhere. Without a key that check reports "unverified" and never acts.
# See docs/games.md, "Verifying it is really in the browser".
STEAM_WEB_API_KEY=
